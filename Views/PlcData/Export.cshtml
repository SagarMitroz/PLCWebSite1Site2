<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css">

<style>
    .card {
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
    }

        .card:hover {
            box-shadow: 0 8px 15px rgba(0,0,0,0.1);
        }

    .card-header {
        background-color: #f8f9fa;
        border-bottom: 1px solid #eaecef;
        border-radius: 8px 8px 0 0;
    }

    .btn-export {
        background-color: #0056b3;
        border-color: #0056b3;
        padding: 10px 20px;
        font-weight: 500;
        transition: all 0.2s;
    }

        .btn-export:hover {
            background-color: #004494;
            border-color: #004494;
        }

    .date-input {
        border-radius: 4px;
        border: 1px solid #ced4da;
        padding: 10px;
    }

    .page-title {
        color: #343a40;
        font-weight: 600;
        margin-bottom: 30px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e9ecef;
    }

    .loader-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(255,255,255,0.85);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 1000;
        visibility: hidden;
        opacity: 0;
        transition: opacity 0.3s, visibility 0.3s;
    }

    .loader-content {
        text-align: center;
        background: white;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    .loader-spinner {
        margin-bottom: 15px;
        color: #0056b3;
    }

    .loader-visible {
        visibility: visible;
        opacity: 1;
    }
</style>

<div class="container py-5">
    <h1 class="page-title"><i class="fas fa-file-export me-2"></i>Export PLC Data</h1>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header py-3">
                    <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Select Date</h5>
                </div>
                <div class="card-body p-4">
                    <div class="form-group mb-4">
                        <label for="exportDate" class="fw-bold">Select Date:</label>
                        <input type="date" id="exportDate" class="form-control date-input" />
                    </div>
                    <button type="button" id="exportExcelBtn" class="btn btn-primary">
                        <i class="fas fa-download me-2"></i>Export to Excel
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Loader overlay -->
<div class="loader-overlay" id="loaderOverlay">
    <div class="loader-content">
        <div class="loader-spinner">
            <i class="fas fa-spinner fa-spin fa-3x"></i>
        </div>
        <h4>Exporting Data...</h4>
        <p class="text-muted mb-0">Please wait while we prepare your Excel file.</p>
    </div>
</div>

<!-- jQuery CDN (required for AJAX) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script>
    $(document).ready(function () {
        $('#exportExcelBtn').on('click', function () {
            const selectedDate = $('#exportDate').val();
            if (!selectedDate) {
                alert('Please select a date.');
                return;
            }

            const loader = $('#loaderOverlay');
            loader.addClass('loader-visible');

            // Get Anti-forgery token if you are using [ValidateAntiForgeryToken]
            const token = $('input[name="__RequestVerificationToken"]').val();

               $.ajax({
        url: `/Plcdata/ExportToExcelPLCdata?startDate=${selectedDate}`,
        type: 'GET',
        xhrFields: {
            responseType: 'blob' // <-- Important for binary file
        },
        success: function (data, status, xhr) {
            let filename = 'PLC_Report.xlsx';
            const disposition = xhr.getResponseHeader('Content-Disposition');
            if (disposition && disposition.indexOf('filename=') !== -1) {
                const matches = /filename\*?=(?:UTF-8'')?"?([^;\r\n"]+)/.exec(disposition);
                if (matches != null && matches[1]) filename = decodeURIComponent(matches[1]);
            }

            const url = window.URL.createObjectURL(data);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            a.remove();
            window.URL.revokeObjectURL(url);

            $('#loaderOverlay').removeClass('loader-visible');
        },
        error: function () {
            alert('Error exporting file.');
            $('#loaderOverlay').removeClass('loader-visible');
        }
    });
        });
    });
</script>

	