<script>
    $(document).ready(function ()
        {
            $('#example').DataTable({
                dom: 'Bfrtip',
                buttons: [
                    'copy', 'csv', 'excel', 'pdf', 'print'
                ]
                // Add other DataTable options as needed
            });
        });
</script>