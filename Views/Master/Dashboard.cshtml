<script>

	 let timeStamps = [];
	 let datasets = {}; // store flow arrays keyed by code
	 let myChart;

	 //  on page load
	 $(document).ready(function () {

			//tanks Load
			 loadTanks();

			//temp
			loadTemps();

		 //Pressures
		  loadPressures();

		 // Load flows and build chart

		  loadchart();

			  initializeChartPage();
			  loadBackwash();
				setInterval(loadBackwash, 900000);

	});

	function loadBackwash() {
		$.ajax({
			url: '/Master/GetBackwashCount', // Controller/Action
			type: 'GET',
			success: function (response) {
				$('#backflush').text(response);
