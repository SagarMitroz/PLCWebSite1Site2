	 //Socket Intilization
	   function initSocket() {

		   

			const siteId = document.getElementById("siteIdforsocket1").innerText.trim();
		
		 //  //const socket = io('https://socket-botnotch.mitroztech.com/');
		 // // const socket = io('http://localhost:3000');
		 //  const socket = io('https://plcsocket.mitroztech.com/');
		 //  //onst socket = io('https://socket-botnotch.mitroztech.com/');
		 //  //const socket = io('http://13.202.25.44:3001/');

		//  console.log("Current Site ID:", siteId);

		// Default socket URL (you can customize for each site)
		let socketUrl;
		 
		switch (siteId) {
			case "1":
				socketUrl = "https://socket-botnotch.mitroztech.com/";
				break;
			
			case "3":
				socketUrl = "https://shaftesburysoc.botnotch.com/";
				break;
			default:
				socketUrl = "https://socket-botnotch.mitroztech.com/"; // fallback
				break;
		}

		// Initialize socket dynamically
		let socket = io(socketUrl);



		  socket.on('connect', () => {
			  console.log("Connected to PLC socket ✅");
		  });

		  socket.on('disconnect', () => {
			  console.warn("Disconnected from PLC socket ❌");
		  });

			 socket.on('dataUpdate', (data) => {
			  // Sometimes PLC sends JSON string → parse it safely
			  let plcData = (typeof data === "string") ? JSON.parse(data) : data;
			 // console.log("PLC Data:", plcData);
			  // Update tanks
			  updateTankUI(plcData);

			  // Update flow meters chart
			  updateChart(plcData.Values);

			  updatePressures(plcData);

			   updateTemperatures(plcData);

			   updateCwpValues(plcData)

			   updateCycleStatus(plcData);
			   
		  });
	  }





	  // Function: update tank UI with live values
		 function updateTankUI(data) {

			 Object.entries(data.Values).forEach(([key, value]) => {
				 let bar = document.getElementById("bar_" + key);
				 let detail = document.getElementById("detail_" + key);

				 if (bar && detail) {
					 let percent = Math.min(Math.max(value, 0), 100); // Clamp between 0–100
					 bar.style.height = percent + "%";
					 detail.innerHTML = percent.toFixed(1) + "%";

					 // Color thresholds
					 if (percent >= 100) {
						 bar.style.backgroundColor = "red";
						 let tankNo = key.split("_")[1];  // "01"

						 showToast(`⚠️ Tank ${tankNo} is full!`);
					 }  else {
						 bar.style.backgroundColor = "#89d2ff";
					 }
					  let cwTankName = $('#Tc_6_tag').data('tankName');
			if (cwTankName && key === cwTankName) {
				$('#Tc_6_tag').text(percent.toFixed(1) + "%");
			}
				 }
			 });
		 }



			

		 //function for chart update live values
	 function updateChart(newData) {
		 const now = new Date();
		 timeStamps.push(now);

			 Object.keys(datasets).forEach(code => {
		 const val = newData[code] ?? 0;

		 // Update chart data
		 datasets[code].push(val);

		 // Update UI label
		 const safeId = code.replace(/[^a-zA-Z0-9]/g, "").toLowerCase();
		 let span = document.getElementById(safeId + "-value");
		 if (span) span.textContent = `(${val.toFixed(2)})`;
	 });

		 // Keep only last 5 minutes of data
		 const fiveMinutesAgo = new Date(now.getTime() - 5 * 60 * 1000);
		 while (timeStamps.length && timeStamps[0] < fiveMinutesAgo) {
			 timeStamps.shift();
			 Object.values(datasets).forEach(arr => arr.shift());
		 }

		 myChart.update();
	 }



	 //pressuredat ui update with live values

	  function updatePressures(data2) {
		 // Normal gauges
		 Object.entries(data2.Values).forEach(([key, value]) => {
			 let gauge = document.getElementById(key.toLowerCase());
			 let label = document.getElementById(key.toLowerCase() + "-value");

			 if (gauge && label) {
				 const inputValue = Math.max(value, 0);
				 const scaledValue = scaleValue(inputValue);

				 gauge.style.setProperty("--rotation", scaledValue + "deg");
				 label.innerHTML = inputValue.toFixed(2) + "<br><span class='gtbar'>Bar</span>";
			 }
		 });

		 // TMP (formula)
		 
			 let ans = ((data2.Values.PS_301 + data2.Values.PS_302) / 2) - data2.Values.PS_303;
			 let final = Math.max(ans, 0);

			 let gauge = document.getElementById("ps_tmp");
			 let label = document.getElementById("ps_tmp-value");

			 if (gauge && label) {
				 const scaledValue = scaleValue(final);
				 gauge.style.setProperty("--rotation", scaledValue + "deg");
				 label.innerHTML = final.toFixed(2) + "<br><span class='gtbar'>Bar</span>";
			 }
		 
	 }



				// One function to update bars
		function updateTemperatures(data) {
		Object.entries(data.Values).forEach(([key, value]) => {
			let fill = document.getElementById("tempFill_" + key);
			let label = document.getElementById("tempLabel_" + key);

			if (fill && label) {
				let tempValue = Math.max(value, 0);
				let percent = Math.min((tempValue / 100) * 100, 100);

				// Horizontal fill
				fill.style.width = percent + "%";
				label.innerHTML = tempValue.toFixed(1) + " &#8451;";

				// Color thresholds
				if (tempValue >= 60) {
					fill.style.backgroundColor = "red";
				} else if (tempValue >= 45) {
					fill.style.backgroundColor = "#f3a423";
				} else {
					fill.style.backgroundColor = "green";
				}
			}
				if (key === "FILTRATION_RUN_HRS") {
		const runtimeMinutes = parseFloat(value) || 0;
		const runtimeHours = runtimeMinutes / 60; // convert to hours

		document.getElementById("runtime").textContent = runtimeHours.toFixed(2);

		
	}

	if (key === "SELECTED_CYCLE") {
			const cycleNo = parseInt(value) || 0;
			const stepNo = parseInt(data.Values?.STEP_NO) || 0;

			const cycleInfo = cycleStepMap[cycleNo];
			let displayText = "No Active Cycle";
			if (cycleInfo) {
				const stepText = cycleInfo.steps[stepNo] || "(UNKNOWN STEP)";
				displayText = `${cycleInfo.name} ${stepText}`;
			}

			document.getElementById("Selectedcycle").innerText = displayText;
			
		}

		if (key === "BACKFLUSH_COUNT") 
		{

			let divElement1 = document.getElementById("backflush");


			if (divElement1) {
							//  divElement1.innerHTML = value.toFixed(1); // Set height to 10%
			}
		}

		});
	}


	//clean water parameter

	{
			function updateCwpValues(data) {
		Object.entries(data.Values).forEach(([key, value]) => {
			let elementId = null;

			if (key === "QS_301") {
				elementId = "cwp-4";
			} else if (key === "PHS_601") {
				elementId = "cwp-2";
			} else if (key === "CLS_601") {
				elementId = "cwp-3";
			} else if (key === "QCS_601") {
				elementId = "cwp-1";
			}

			if (elementId) {
				let divElement = document.getElementById(elementId);
				if (divElement) {
					divElement.innerHTML = value.toFixed(1);
				}
			}
		});
	}
	}
	//  cycles data
			function updateCycleStatus(plcData) {
		let selectedCycle = plcData.Values.Selected_Cycle;
		let stepNo = plcData.Values.Step_No;

		if (selectedCycle !== undefined && stepNo !== undefined) {
			let element = document.getElementById("Selectedcycle");
			if (element) {
				element.innerText = getCycleMessage(selectedCycle, stepNo);
			}
		}
	}



	// cycle message
		function getCycleMessage(cycle, stepNo) {
		const cycleData = cycleStepMap[cycle];
		if (!cycleData) return "No sequence running";

		const stepMessage = cycleData.steps[stepNo] || "";
		return stepMessage
			? `${cycleData.name} ${stepMessage}`
			: cycleData.name;
	}




	//common functions
	 // scale value  function
	  function scaleValue(inputValue, inputMin = 0, inputMax = 3, outputMin = 0, outputMax = 180) {
			 return ((inputValue - inputMin) / (inputMax - inputMin)) * (outputMax - outputMin) + outputMin;
		 }

		 //chart colors
		  function getColor(i) {
		 const colors = ["red", "green", "blue", "orange", "purple", "brown", "teal", "pink"];
		 return colors[i % colors.length];
	 }

	 //toast
		 function showToast(message) {
		const toast = document.getElementById("toast-container");
		const msg = document.getElementById("toast-message");

		msg.innerText = message;
		toast.style.display = "block";

		// Auto hide after 3 seconds
		setTimeout(() => {
			toast.style.display = "none";
		}, 10000);
	}







	 let myChartInstance = null;

	function handleDateChange() {
		const selectedDate = this.value;
		if (selectedDate) {
			const dateRange = `${selectedDate} to ${selectedDate}`;
			loadChartData(dateRange);
		}
	}

	function initializeChartPage() {
		const dateInput = document.getElementById("dateInput");
		const chartContainer = document.getElementById("chartContainer");
		const noDataMessage = document.getElementById("noDataMessage");

		if (!dateInput) {
			console.warn("Date input not found.");
			return;
		}

		// Set default date to today
		const today = new Date().toISOString().split("T")[0];
		dateInput.value = today;

		// Load chart for default date
		loadChartData(`${today} to ${today}`);

		// Remove old event listener if already added
		dateInput.removeEventListener("change", handleDateChange);
		dateInput.addEventListener("change", handleDateChange);
	}

	function loadChartData(dateRange) {
		$.ajax({
			url: "/Master/GetPieChartData",
			type: "GET",
			data: { dateRange: dateRange },
			dataType: "json",
			success: function (data) {

				const chartContainer = $("#chartContainer");
				const noDataMessage = $("#noDataMessage");

				if (!Array.isArray(data) || data.length === 0) {
					console.error("No chart data received.");
					chartContainer.hide();
					noDataMessage.show();
					return;
				}

				const pieData = data[0];
					const fs101 = pieData.fs101 ?? 0;
	const fs102 = pieData.fs102 ?? 0;
	const fs301 = pieData.fs301 ?? 0;
	const fs302 = pieData.fs302 ?? 0;
	const fs601 = pieData.fs601 ?? 0;
	const recdate = pieData.dataUsedStartDate ?? "N/A";

	// Assign values to HTML elements
	document.getElementById("wastew").textContent = `(${fs101.toFixed(2)})`;
	document.getElementById("fww").textContent = `(${fs102.toFixed(2)})`;
	document.getElementById("drainw").textContent = `(${fs301.toFixed(2)})`;
	document.getElementById("permitw").textContent = `(${fs302.toFixed(2)})`;
	document.getElementById("wow").textContent = `(${fs601.toFixed(2)})`;

	 const date = new Date(recdate);

const formattedDate = `${String(date.getDate()).padStart(2, '0')}/${String(date.getMonth() + 1).padStart(2, '0')}/${date.getFullYear()}`;

document.getElementById("dateofrec").textContent = `Last Updated On: ${formattedDate}`;
	 document.getElementById("dateInput").value = recdate;


				//const selectedKeys = ["fs101", "fs102", "fs301", "fs302", "fs601"];
				const selectedKeys = ["fs101", "fs102", "fs302", "fs601"];
				const yValues = selectedKeys.map(key => pieData[key]);
				//const xValues = ["Waste", "F/W", "Drain", "Permeate", "WO"];
				const xValues = ["Waste", "F/W","Permeate", "WO"];

				const barColors = [
					"#b91d47", "#00aba9",
					"#e8c3b9", "#1e7145", "#f39c12"
				];

				chartContainer.show();
				noDataMessage.hide();

				const ctx = document.getElementById("myDonutChart");

				if (myChartInstance) {
					myChartInstance.destroy();
				}

				   const fsper = pieData.fsper !== undefined ? pieData.fsper.toFixed(2) : "0.00";

				myChartInstance = new Chart(ctx, {
					type: "bar",
					data: {
						labels: xValues,
						datasets: [{
							backgroundColor: barColors,
							data: yValues
						}]
					},
				   options: {
		plugins: {
			legend: {
				display: false
			},
			title: {
				display: true,
				//text: `${fsper} % Water Processed`,
				position: 'bottom',
				font: {
		weight: 'bold',
		size: 14
	}
			}
		}
	}
				});
			},
			error: function (error) {
				console.error("Error fetching chart data:", error);
			}
		});
	}


