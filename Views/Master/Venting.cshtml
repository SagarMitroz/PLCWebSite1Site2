<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Venting Control System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .status-indicator {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 10px;
        }
        .status-green {
            background-color: #2ecc71;
        }
        .status-red {
            background-color: #ff7675;
        }
        .operation-btn {
            background-color: #74b9ff;
            border: none;
            min-width: 100px;
        }
        .command-btn {
            background-color: #ff7675;
            color: white;
            border: none;
            padding: 2px 12px;
            border-radius: 4px;
            font-size: 14px;
        }
        .step-circle {
            width: 24px;
            height: 24px;
            background-color: #ff7675;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
        }

            


        .value-box {
            background-color: #ffeaa7;
            padding: 2px 8px;
            border-radius: 4px;
            display: inline-block;
        }
        .card {
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            border-radius: 12px;
        }
        .table th {
            background-color: #f8faff;
            font-weight: 500;
        }

        
    </style>
</head>
<body class="bg-light">
    <div class="container-fluid py-4" style="margin-top: 5%;">
        <h2 class="text-primary mb-4 fw-bold" style="color:#046bff">Venting</h2>
