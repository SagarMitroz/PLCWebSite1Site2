<script>
    $(document).ready(function () {
        // Fetch alarm names
        $.ajax({
            url: '/Master/GetAlarms',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                let alarmDropdown = $("#alarmName");
                alarmDropdown.empty().append('<option value="">Select Alarm</option>');
                $.each(data, function (index, alarm) {
                    alarmDropdown.append(`<option value="${alarm.id}">${alarm.name}</option>`);
                });
            },
            error: function () {
                alert("Failed to load alarms.");
            }
        });

        // Handle form submission
        $("#addAlarmForm").on("submit", function (e) {
            e.preventDefault();

            // Manually collect form values
            let alarmData = {
                AlarmId: $("#alarmName").val(),
                HH: $("#hh").val(),
                H: $("#h").val(),
                LL: $("#ll").val(),
                L: $("#l").val()
            };

            console.log(alarmData); // Debugging purpose

            // Send data via AJAX
               $.ajax({
        url: '/Master/SaveAlarm',
        type: 'POST',
        contentType: 'application/json', // Ensure this is set
        data: JSON.stringify(alarmData), // Convert data to JSON format
        success: function (response) {
            if (response.success) {
                alert("Alarm saved successfully!");
                $("#addAlarmModal").modal("hide");
                $("#addAlarmForm")[0].reset();
                window.location.reload();
            } else {
                alert("Failed to save alarm: " + response.message);
            }
        },
        error: function (xhr, status, error) {
            console.error("Error:", error); // Log the error for debugging
            alert("An error occurred while saving the alarm.");
        }
    });
        });
    });
</script>

