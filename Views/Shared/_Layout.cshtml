			font-weight: bold;
			margin-bottom: 1rem;
		}

		.sidebar-item {
			padding: 0.5rem 0;
		}

			.sidebar-item a {
				color: #3a4fcf;
				text-decoration: none;
			}

			.sidebar-item :hover {
				color: #3a4fcf;
				text-decoration: underline;
			}

		/* Overlay to detect clicks outside the sidebar */
		#overlay {
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			/*  background-color: rgba(0, 0, 0, 0.5); */
			display: none;
			z-index: 1049;
		}

			#overlay.active {
				display: block;
			}

	</style>
