	<script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script>
		const userRole = 'Admin';
		const notificationButton = document.getElementById('notificationButton');
		const badge = document.getElementById('notificationBadge');
		const alarmButton = document.getElementById('alarmNotificationButton');
		const alarmBadge = document.getElementById('alarmNotificationBadge');

		let notificationPopover;
		let alarmPopover;

		function createPopover(buttonElement, title, content) {
			return new bootstrap.Popover(buttonElement, {
				html: true,
				sanitize: false,
				trigger: 'manual',
				title: title,
				content: content,
				placement: 'bottom'
			});
		}

		function hideElement(element) {
			if (element) {
				element.classList.add('d-none');
			}
		}

		function showElement(element) {
			if (element) {
				element.classList.remove('d-none');
			}
		}

		function togglePopover(popover, buttonElement) {
			if (!popover || !buttonElement) {
				return;
			}

			const isOpen = buttonElement.getAttribute('aria-describedby');
			if (isOpen) {
				popover.hide();
			} else {
				popover.show();
			}
		}

		function refreshPopover(buttonElement, popover, title, content) {
			const wasOpen = !!buttonElement.getAttribute('aria-describedby');

			if (popover) {
				popover.dispose();
			}

			const newPopover = createPopover(buttonElement, title, content);

			if (wasOpen) {
				newPopover.show();
			}

			return newPopover;
		}

		function formatNotificationTime(value) {
			if (!value) {
				return '-';
			}

			const parsedDate = new Date(value);
			if (Number.isNaN(parsedDate.getTime())) {
				return value;
			}

			return parsedDate.toLocaleTimeString('en-US', {
				hour: '2-digit',
				minute: '2-digit',
				second: '2-digit',
				hour12: false
			});
		}

		document.addEventListener('DOMContentLoaded', function () {
			notificationPopover = createPopover(
				notificationButton,
				"Today's Filtration Summary",
				'<div class="text-muted">Loading...</div>'
			);

			alarmPopover = createPopover(
				alarmButton,
				'PLC Alarms',
				'<div class="text-muted">Loading...</div>'
			);

			notificationButton.addEventListener('click', function (e) {
				e.preventDefault();
				togglePopover(notificationPopover, notificationButton);
			});

			alarmButton.addEventListener('click', function (e) {
				e.preventDefault();
				togglePopover(alarmPopover, alarmButton);
			});

			document.addEventListener('click', function (e) {
				if (!e.target.closest('#notificationButton, .popover')) {
					notificationPopover.hide();
				}

				if (!e.target.closest('#alarmNotificationButton, .popover')) {
					alarmPopover.hide();
				}
			});

			notificationButton.addEventListener('shown.bs.popover', function () {
				hideElement(badge);
			});

			alarmButton.addEventListener('shown.bs.popover', function () {
				hideElement(alarmBadge);
			});

			loadNotifications();
			setInterval(loadNotifications, 15000);
			loadAlarms();
			setInterval(loadAlarms, 20000);
		});

		function requestJson(url) {
			return fetch(url, {
				method: 'GET',
				headers: {
					'X-Requested-With': 'XMLHttpRequest'
				}
			}).then(function (response) {
				if (!response.ok) {
					throw new Error('Request failed');
				}

				return response.json();
			});
		}

		function loadNotifications() {
			let lastCount = localStorage.getItem('lastFiltrationCount') || 0;
			requestJson('/Master/GetFiltrationNotifications').then(function (data) {
				const notifications = Array.isArray(data?.notifications) ? data.notifications : [];
				const currentCount = notifications.length;

				if (currentCount > lastCount) {
					showElement(badge);
				} else {
					hideElement(badge);
				}

				localStorage.setItem('lastFiltrationCount', currentCount);

				let content = `
					<div style="max-height:200px; overflow-y:auto;">
						<table class="table table-sm table-borderless mb-0">
							<thead>
								<tr>
									<th>Event</th>
									<th>Created On</th>
								</tr>
							</thead>
							<tbody>
				`;

				if (!notifications.length) {
					content += `<tr><td colspan="2" class="text-muted">No filtration notifications found.</td></tr>`;
				}

				notifications.slice(0, 3).forEach(function (n) {
					const timeOnly = formatNotificationTime(n.createdOn);
					content += `<tr><td>${n.filtrationEvent || '-'}</td><td>${timeOnly}</td></tr>`;
				});

				content += `
							</tbody>
						</table>
					</div>
					<div class="text-center mt-2">
						<a href="/Master/FiltrationReport" class="btn btn-sm btn-primary">View All</a>
					</div>
				`;

				notificationPopover = refreshPopover(
					notificationButton,
					notificationPopover,
					"Today's Filtration Summary",
					content
				);
			}).catch(function () {
				notificationPopover = refreshPopover(
					notificationButton,
					notificationPopover,
					"Today's Filtration Summary",
					'<div class="text-danger">Unable to load filtration notifications.</div>'
				);
			});
		}


		function loadAlarms() {
			let lastAlarmCount = localStorage.getItem('lastAlarmCount') || 0;
			requestJson('/Master/PlcAlarmNotifications').then(function (data) {
				const alarms = Array.isArray(data?.alarms) ? data.alarms : [];
				const currentAlarmCount = alarms.length;

				if (currentAlarmCount > lastAlarmCount) {
					showElement(alarmBadge);
					alarmBadge.textContent = '';
					alarmBadge.style.padding = '0.4rem';
					alarmBadge.style.minWidth = '0';
					alarmBadge.style.minHeight = '0';
					alarmBadge.style.borderRadius = '50%';
				} else {
					hideElement(alarmBadge);
				}

				localStorage.setItem('lastAlarmCount', currentAlarmCount);

				let content = `
					<p style="margin:0; font-weight:bold;">Latest PLC Alarms</p>
					<div style="max-height:200px; overflow-y:auto;">
						<table class="table table-sm table-borderless mb-0">
							<thead><tr><th>Tag Name</th><th>Time</th></tr></thead>
							<tbody>
				`;

				if (!alarms.length) {
					content += `<tr><td colspan="2" class="text-muted">No PLC alarms found.</td></tr>`;
				}

				alarms.forEach(function (a) {
					const timeOnly = formatNotificationTime(a.createdOn);
					content += `<tr><td>${a.tagName || '-'}</td><td>${timeOnly}</td></tr>`;
				});

				content += `
							</tbody>
						</table>
					</div>
					<div class="text-center mt-2">
						<a href="/Master/alarmlogreport" class="btn btn-sm btn-primary">View All</a>
					</div>
				`;

				alarmPopover = refreshPopover(
					alarmButton,
					alarmPopover,
					'PLC Alarms',
					content
				);
			}).catch(function () {
				alarmPopover = refreshPopover(
					alarmButton,
					alarmPopover,
					'PLC Alarms',
					'<div class="text-danger">Unable to load PLC alarms.</div>'
				);
			});
		}

	</script>
</body>
</html>
